# Cipherware marketing — clean URLs (LiteSpeed / Apache)
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # External redirects use THE_REQUEST so internal rewrites don't loop
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+about\.html[\s?] [NC]
  RewriteRule ^ /about [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+services\.html[\s?] [NC]
  RewriteRule ^ /services [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+contact\.html[\s?] [NC]
  RewriteRule ^ /contact [R=301,L]

  # Serve real files/dirs as-is (css, js, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Extensionless → .html
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^services/?$ services.html [L]
  RewriteRule ^contact/?$ contact.html [L]
</IfModule>
